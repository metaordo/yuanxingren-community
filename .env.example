# === LLM (required) ===
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com

# === Security (required - generate with: python3 -c "import secrets; print(secrets.token_hex(32))") ===
PA_JWT_SECRET=change-me-to-a-random-string

# === ZAP daemon (optional) ===
PA_ZAP_BASE_URL=http://127.0.0.1:8090
PA_ZAP_API_KEY=change-me

# === Data (optional) ===
PA_DATA_DIR=./backend/data
